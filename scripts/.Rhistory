#packages:
library(remotes)
library(covsel)
library(sabinaNSDM)
library(terra)
library(readxl)
library(biomod2)
library(sp)
library(raster)
#####Load occurrences
R.areolata_reg_train_occ <- read.csv("data/occurences_absences/occ_thinned/regional_occ_train.csv")
R.areolata_glob_train_occ <- read.csv("data/occurences_absences/occ_thinned/global_occ_train.csv")
#####Load pseudo-absences
global_PA_train <- read.csv("data/occurences_absences/abs_global/glob_PA_strat_6.csv")
regional_PA_train <- read.csv("data/occurences_absences/abs_reg/reg_PA_strat_5.csv")
#####Load env var scenarios
expl.var.global <- rast("data/env_var/scenarios_spatraster/expl.var.global.tif")
##############Global model projection
load("Results/Global/Models/R.areolata/R.areolata.AllModels.ensemble.models.out")
######Get Variable importance scores
#Global
glob_models_var_import <- read.csv("Results/Global/Values/R.areolata_indvar.csv")
